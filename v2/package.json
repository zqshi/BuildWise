{
  "name": "buildwise-v2-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "test": "c8 node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "preview": "vite preview",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:skills": "npm --prefix backend run check:skills",
    "seed:agentic:flow": "node scripts/reset-and-seed-agentic-flow-mock.mjs",
    "demo:openclaw:real": "node scripts/openclaw-real-llm-demo.mjs",
    "e2e:creative-generator:rc": "node scripts/run-creative-generator-rc-e2e.mjs",
    "clean:workspace": "bash scripts/clean-workspace.sh",
    "report:readiness": "node scripts/report-readiness.mjs",
    "dev:stack:start": "bash scripts/start-dev-stack.sh",
    "dev:stack:stop": "bash scripts/stop-dev-stack.sh",
    "install:all": "npm install && npm --prefix backend install",
    "build:all": "npm run build && npm --prefix backend run build",
    "verify:all": "npm run check:hygiene && npm run check:boundaries && npm run check:skills && npm run typecheck && npm run build && npm run report:readiness && npm --prefix backend run check:boundaries && npm --prefix backend run typecheck && npm --prefix backend run build && npm --prefix backend run test:contract"
  },
  "dependencies": {
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "markdown-it": "^14.1.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-code-editor": "^0.14.1",
    "dompurify": "^3.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/markdown-it": "^14.1.2",
    "@types/prismjs": "^1.26.6",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "c8": "^10.1.0",
    "lint-staged": "^15.2.0",
    "simple-git-hooks": "^2.11.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome lint --write",
      "biome format --write"
    ]
  }
}
