{
  "name": "buildwise-v2-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "zqshi <labixiaoxin-why@outlook.com>",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "test": "c8 node --import tsx --test \"tests/**/*.test.ts\"",
    "preview": "vite preview",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "seed:agentic:flow": "node scripts/reset-and-seed-agentic-flow-mock.mjs",
    "e2e:creative-generator:rc": "node scripts/run-creative-generator-rc-e2e.mjs",
    "reset:business-env": "node scripts/reset-business-environment.mjs",
    "clean:workspace": "bash scripts/clean-workspace.sh",
    "report:readiness": "node scripts/report-readiness.mjs",
    "check:version-discipline": "node scripts/check-version-discipline.mjs",
    "dev:stack:start": "bash scripts/start-dev-stack.sh",
    "dev:stack:stop": "bash scripts/stop-dev-stack.sh",
    "install:all": "npm install && npm --prefix backend install",
    "build:all": "npm run build && npm --prefix backend run build",
    "verify:all": "npm run check:hygiene && npm run lint && npm run check:boundaries && npm run check:version-discipline && npm run typecheck && npm run build && npm test && npm run report:readiness && npm --prefix backend run verify:prod-release"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.23.1",
    "@tiptap/extension-highlight": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-table": "^3.23.1",
    "@tiptap/extension-table-cell": "^3.23.1",
    "@tiptap/extension-table-header": "^3.23.1",
    "@tiptap/extension-table-row": "^3.23.1",
    "@tiptap/extension-task-item": "^3.23.1",
    "@tiptap/extension-task-list": "^3.23.1",
    "@tiptap/extension-typography": "^3.23.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "dompurify": "^3.2.4",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.1",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-code-editor": "^0.14.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@testing-library/react": "^13.4.0",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "c8": "^10.1.0",
    "lint-staged": "^15.2.0",
    "simple-git-hooks": "^2.11.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "vite": "^8.0.2"
  },
  "overrides": {
    "esbuild": "0.27.4",
    "glob": "13.0.6",
    "rollup": "4.60.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome lint --write",
      "biome format --write"
    ]
  }
}
