# ---- 基础服务 ----
NODE_ENV=development
HOST=127.0.0.1
PORT=5055
SERVICE_NAME=buildwise-v2-backend
SERVICE_VERSION=0.1.0

# ---- 网络与安全 ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
SHUTDOWN_TIMEOUT_MS=10000

# ---- 认证 ----
AUTH_MODE=off
AUTH_TOKENS_JSON={"token-owner":"owner","token-qa":"qa"}
AUTH_PUBLIC_PATH_PREFIXES=/health,/ready,/api/v1/status,/api/v1/collab/share/,/api/v1/auth/

# ---- JWT (AUTH_MODE=jwt 时必填) ----
JWT_SECRET=
JWT_ACCESS_TTL_SEC=7200
JWT_REFRESH_TTL_SEC=604800

# ---- 存储 ----
STORAGE_BACKEND=json
WORKSPACE_DB_FILE=./workspace.db
WORKSPACE_DATA_FILE=./data.runtime.json

# ---- LLM 通用 ----
LLM_PROVIDER=anthropic
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_REQUIRED=false
LLM_REQUEST_TIMEOUT_MS=180000
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_EXCERPT_LENGTH=9000
LLM_MAX_CHUNK_COUNT=6
LLM_MAX_PROMPT_BUDGET=24000
LLM_UNKNOWN_SIGNAL_THRESHOLD=2

# ---- Anthropic 兼容 ----
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# ---- OpenClaw Gateway ----
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main
OPENCLAW_HOME=
BUILDWISE_OPENCLAW_SKILLS_ENABLED=false

# ---- GitHub ----
GITHUB_TOKEN=
PROJECT_REPO_ROOT=/tmp/buildwise-project-repos

# ---- 依赖 ----
DEPENDENCY_REQUIRED=false

# ---- 高级 ----
BUILDWISE_PREFER_PROCESS_ENV=0
