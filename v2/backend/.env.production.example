# ---- 基础服务 ----
NODE_ENV=production
HOST=0.0.0.0
PORT=5055
SERVICE_NAME=buildwise-v2-backend
SERVICE_VERSION=0.1.0

# ---- 网络与安全 ----
CORS_ORIGINS=https://app.example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
SHUTDOWN_TIMEOUT_MS=10000

# ---- 认证 ----
AUTH_MODE=jwt
AUTH_DEBUG=false
AUTH_TOKENS_JSON={}
AUTH_PUBLIC_PATH_PREFIXES=/health,/ready,/metrics,/api/v1/status,/api/v1/ops/metrics,/api/v1/ops/metrics/prometheus,/api/v1/collab/share/,/api/v1/auth/sms/,/api/v1/auth/refresh,/api/v1/auth/logout

# 首次部署时设置初始管理员手机号，系统启动时自动注册（仅当平台无任何成员时生效）
# 注册完成后建议移除此配置
BOOTSTRAP_ADMIN_PHONE=

# ---- JWT (AUTH_MODE=jwt 时必填) ----
JWT_SECRET=replace-with-at-least-32-char-secret
JWT_ACCESS_TTL_SEC=7200
JWT_REFRESH_TTL_SEC=604800

# ---- 存储 ----
STORAGE_BACKEND=sqlite
WORKSPACE_DB_FILE=./workspace.db
WORKSPACE_DATA_FILE=./data.runtime.json
ALLOW_SEED_DATA_BOOTSTRAP=false

# ---- LLM 通用 ----
LLM_PROVIDER=anthropic
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_REQUIRED=false
LLM_REQUEST_TIMEOUT_MS=180000
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_EXCERPT_LENGTH=9000
LLM_MAX_CHUNK_COUNT=6
LLM_MAX_PROMPT_BUDGET=24000
LLM_UNKNOWN_SIGNAL_THRESHOLD=2

# ---- Anthropic 兼容 ----
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# ---- GitHub ----
GITHUB_TOKEN=
PROJECT_REPO_ROOT=/srv/buildwise/project-repos

# ---- 依赖 ----
DEPENDENCY_REQUIRED=true

# ---- OpenClaw Gateway (推荐模式） ----
# 设置为 1 使用 OpenClaw Gateway，0 使用直接 LLM（降级模式）
USE_OPENCLAW_GATEWAY=1
OPENCLAW_GATEWAY_URL=
OPENCLAW_API_KEY=
OPENCLAW_TIMEOUT_MS=120000
OPENCLAW_DEFAULT_MODEL=claude-sonnet-4-20250514
AGENT_MAX_RETRIES=2
AGENT_RETRY_INITIAL_DELAY_MS=1000
AGENT_RETRY_BACKOFF_MULTIPLIER=2

# ---- 高级 ----
BUILDWISE_PREFER_PROCESS_ENV=0
