{
  "name": "buildwise-v2-backend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "zqshi <labixiaoxin-why@outlook.com>",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "check:boundaries": "node ../scripts/check-boundaries.mjs",
    "check:hygiene": "node ../scripts/check-repo-hygiene.mjs",
    "reset:business-env": "node ../scripts/reset-business-environment.mjs",
    "clean:workspace": "bash ../scripts/clean-workspace.sh",
    "test": "npm run build && c8 node --test tests/*.test.mjs",
    "test:contract": "node tests/contract.mjs && node tests/contract.git-intake.mjs",
    "test:e2e": "npm run build && npm run e2e:agent-flow",
    "test:contract:sqlite": "STORAGE_BACKEND=sqlite node tests/contract.mjs && STORAGE_BACKEND=sqlite node tests/contract.git-intake.mjs",
    "verify:prod-readiness": "npm run check:hygiene && npm run lint && npm run check:boundaries && npm run check:prompts && npm run check:prompts:replay && npm run check:agents && npm run typecheck && npm run build && node --test tests/*.test.mjs && npm run test:contract",
    "verify:prod-readiness:sqlite": "npm run verify:prod-readiness",
    "verify:prod-release": "npm run verify:prod-readiness && node scripts/verify-production-release.mjs",
    "check:prompts": "node scripts/check-prompt-quality.mjs",
    "check:prompts:replay": "node scripts/check-prompt-replay.mjs",
    "check:agents": "node scripts/check-agent-assets.mjs",
    "e2e:agent-flow": "node scripts/e2e-agent-flow.mjs",
    "ops:preflight": "node scripts/check-preflight-baseline.mjs",
    "ops:llm-check": "node scripts/check-llm-baseline.mjs",
    "ops:alerts": "node scripts/check-alert-baseline.mjs",
    "ops:rollback": "node scripts/rollback-latest-deployment.mjs",
    "ops:backup-drill": "node scripts/backup-restore-drill.mjs",
    "migrate:sqlite": "node scripts/migrate-json-to-sqlite.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "format:write": "biome format --write ./src"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "fastify": "^5.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^26.4.0",
    "c8": "^10.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "ajv": "8.18.0",
    "glob": "13.0.6"
  }
}
