{
  "name": "buildwise-v2-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "check:boundaries": "node ../scripts/check-boundaries.mjs",
    "test:contract": "node tests/contract.mjs",
    "test:contract:sqlite": "STORAGE_BACKEND=sqlite node tests/contract.mjs",
    "verify:prod-readiness": "npm run check:boundaries && npm run check:prompts && npm run check:prompts:replay && npm run typecheck && npm run build && npm run test:contract",
    "verify:prod-readiness:sqlite": "npm run verify:prod-readiness && npm run test:contract:sqlite",
    "check:prompts": "node scripts/check-prompt-quality.mjs",
    "check:prompts:replay": "node scripts/check-prompt-replay.mjs",
    "ops:preflight": "node scripts/check-preflight-baseline.mjs",
    "ops:llm-check": "node scripts/check-llm-baseline.mjs",
    "ops:alerts": "node scripts/check-alert-baseline.mjs",
    "ops:rollback": "node scripts/rollback-latest-deployment.mjs",
    "ops:backup-drill": "node scripts/backup-restore-drill.mjs",
    "migrate:sqlite": "node scripts/migrate-json-to-sqlite.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4"
  }
}
