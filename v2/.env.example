# BuildWise 前端环境变量
VITE_API_BASE=
VITE_API_PROXY_TARGET=http://127.0.0.1:5055

# ── 超时配置（毫秒）──────────────────────────────────────────────
# 默认 API 请求超时
VITE_API_REQUEST_TIMEOUT_MS=30000

# 教练对话超时（单次 LLM 调用）
VITE_COACH_CHAT_TIMEOUT_MS=600000

# 附件分析超时
VITE_ANALYSIS_JOB_TIMEOUT_MS=2700000
VITE_ANALYSIS_QUEUED_STALL_TIMEOUT_MS=300000
VITE_ANALYSIS_RUNNING_STALL_TIMEOUT_MS=2400000

# 轮询间隔
VITE_POLL_INTERVAL_MS=2000
VITE_POLL_BACKOFF_INITIAL_MS=2000
VITE_POLL_MAX_BACKOFF_MS=30000
VITE_POLL_MAX_CONSECUTIVE_ERRORS=20

# 会话过期时间（秒）
VITE_SESSION_MAX_AGE_SECONDS=7200

