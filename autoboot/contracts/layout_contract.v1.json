{
  "name": "buildwise-react-workspace-layout-contract",
  "version": "1.1.0",
  "description": "约束 v2 React 单入口工作台的核心编排能力不回退。",
  "baseline_file": "v2/index.html",
  "target_file": "v2/src/App.tsx",
  "rules": [
    {
      "id": "dock_navigation",
      "title": "左侧导航编排",
      "weight": 10,
      "critical": true,
      "baseline_patterns": [
        "<div id=\"root\"></div>"
      ],
      "target_patterns": [
        "<DockSidebar",
        "onShowDashboard={() => controller.setActiveView(\"dashboard\")}",
        "onShowProjects={() => controller.setActiveView(\"projects\")}"
      ]
    },
    {
      "id": "dashboard_view",
      "title": "仪表盘与模型中台",
      "weight": 15,
      "critical": true,
      "baseline_patterns": [
        "<div id=\"root\"></div>"
      ],
      "target_patterns": [
        "<DashboardView",
        "modelOpsPanel={",
        "<ModelOpsPanel"
      ]
    },
    {
      "id": "projects_workspace",
      "title": "项目工作台编排",
      "weight": 20,
      "critical": true,
      "baseline_patterns": [
        "<div id=\"root\"></div>"
      ],
      "target_patterns": [
        "<ProjectsWorkspace",
        "projectPanelMode={controller.projectPanelMode}",
        "onShowCreateProject={() => controller.setShowCreateProject(true)}",
        "onShowCreateIteration={() => controller.setShowCreateIteration(true)}"
      ]
    },
    {
      "id": "iteration_management",
      "title": "迭代管理与切换",
      "weight": 20,
      "critical": true,
      "baseline_patterns": [
        "<div id=\"root\"></div>"
      ],
      "target_patterns": [
        "currentIteration={controller.currentIteration}",
        "iterations={controller.iterations}",
        "onEnterIteration={controller.handleEnterIteration}",
        "onSwitchToProjectPanel={() => controller.setProjectPanelMode(\"project\")}"
      ]
    },
    {
      "id": "iteration_chat_workflow",
      "title": "迭代内沟通与附件分析",
      "weight": 20,
      "critical": true,
      "baseline_patterns": [
        "<div id=\"root\"></div>"
      ],
      "target_patterns": [
        "chatMessages={controller.chatMessages}",
        "onUpload={controller.handleUpload}",
        "analysisReport={controller.analysisReport}",
        "showAnalysisPanel={controller.showAnalysisPanel}",
        "onChatSend={controller.handleSend}"
      ]
    },
    {
      "id": "evaluation_governance",
      "title": "创建与治理弹窗能力",
      "weight": 15,
      "critical": false,
      "baseline_patterns": [
        "<div id=\"root\"></div>"
      ],
      "target_patterns": [
        "<CreateProjectModal",
        "<CreateIterationModal",
        "onSubmit={controller.handleCreateProject}",
        "onSubmit={controller.handleCreateIteration}"
      ]
    }
  ]
}
