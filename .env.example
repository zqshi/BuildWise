# BuildWise docker-compose 环境变量
# 复制为 .env 并填写实际值后再执行 docker compose up

# ---- 必填 ----
JWT_SECRET=          # 至少 32 字符，用于签发 JWT token
CORS_ORIGINS=        # 允许的前端域名，逗号分隔，如 https://app.example.com

# ---- 可选（有默认值） ----
JWT_ACCESS_TTL_SEC=1800        # Access token 有效期（秒），默认 30 分钟
JWT_REFRESH_TTL_SEC=604800     # Refresh token 有效期（秒），默认 7 天
RATE_LIMIT_WINDOW_MS=60000     # 限流窗口（毫秒）
RATE_LIMIT_MAX=200             # 窗口内最大请求数
LOG_LEVEL=info                 # 日志级别：debug / info / warn / error

# ---- LLM（如需 AI 分析功能）----
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_REQUIRED=false

# ---- OpenClaw Gateway（如需技能编排）----
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
